TELEGRAM_BOT_TOKEN=123456789:replace_with_token_from_BotFather
TELEGRAM_CHAT_ID=-1001234567890
# Необязательно: ID темы, если группа использует форумные темы
TELEGRAM_TOPIC_ID=

# Обязательные данные административной панели
ADMIN_USERNAME=replace_with_admin_username
# Рекомендуется пароль длиной 16+ символов
ADMIN_PASSWORD=replace_with_a_unique_password_of_16_or_more_characters
# Сгенерируйте командой: node .\generate-admin-secret.mjs
ADMIN_SESSION_SECRET=replace_with_generated_random_secret

# Vercel production: автоматически добавляются после подключения Neon и Blob
DATABASE_URL=postgresql://replace_with_neon_connection_string
BLOB_READ_WRITE_TOKEN=replace_with_private_blob_token
# Включите только на HTTPS-хостинге
# NODE_ENV=production
# TRUST_PROXY=true
